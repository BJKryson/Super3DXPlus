#!/bin/bash
# Run once by systemd from the kernel command line (systemd.run=), as root, before the normal boot: makes the wmmt user, SSH and a hostname.
exec > /boot/firmware/firstrun.log 2>&1
set -x
HASH='@HASH@'
KEY='@KEY@'
id wmmt || useradd -m -s /bin/bash wmmt
for g in sudo adm dialout audio video plugdev input render netdev gpio spi i2c cdrom games users; do getent group $g >/dev/null && usermod -aG $g wmmt; done
echo "wmmt:$HASH" | chpasswd -e
install -d -m 700 -o wmmt -g wmmt /home/wmmt/.ssh
echo "$KEY" > /home/wmmt/.ssh/authorized_keys
chown wmmt:wmmt /home/wmmt/.ssh/authorized_keys; chmod 600 /home/wmmt/.ssh/authorized_keys
echo 'wmmt ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/010_wmmt; chmod 440 /etc/sudoers.d/010_wmmt
rm -f /etc/ssh/sshd_config.d/rename_user.conf /etc/sudoers.d/010_pi-nopasswd
systemctl enable ssh
systemctl disable userconfig.service
systemctl enable getty@tty1.service
touch /etc/cloud/cloud-init.disabled
echo wmmt > /etc/hostname
sed -i 's/127.0.1.1.*/127.0.1.1\twmmt/' /etc/hosts
rm -f /boot/firmware/userconfig.txt /boot/firmware/user-data /boot/firmware/meta-data
sed -i 's| systemd\.run[^ ]*||g; s| systemd\.unit=[^ ]*||g' /boot/firmware/cmdline.txt
sync
exit 0
